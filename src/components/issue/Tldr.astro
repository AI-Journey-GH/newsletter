---
import { md } from '../../lib/utils';
interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<!-- Always dark, so the 30-second summary stands out at the top of every issue -->
<section id="thirty-seconds" class="tldr theme-dark p-6 md:p-9" aria-labelledby="tldr-title">
  <h2 id="tldr-title" class="eyebrow eyebrow--line">This week in 30 seconds</h2>
  <ol class="num-list mt-6">
    {items.map((item) => <li><span set:html={md(item)} /></li>)}
  </ol>
</section>

<style>
  .tldr {
    border-radius: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
  }
  @media screen {
    .tldr {
      padding: clamp(1.5rem, 3vw, 2.25rem);
      border-radius: 1rem;
    }
    .tldr .num-list {
      gap: 1.25rem;
    }
    .tldr .num-list > li {
      grid-template-columns: 1.75rem minmax(0, 1fr);
      align-items: start;
      gap: 0.875rem;
      font-size: 1rem;
      line-height: 1.75;
    }
    .tldr .num-list > li + li {
      padding-block-start: 1.25rem;
      border-block-start: 1px solid var(--border-strong);
    }
    .tldr .num-list > li::before {
      display: grid;
      place-items: center;
      inline-size: 1.75rem;
      block-size: 1.75rem;
      margin-block-start: 0.125rem;
      border: 1px solid var(--border-strong);
      border-radius: 50%;
      background: var(--surface-2);
      color: var(--color-cyan-400);
      font-family: var(--font-sans);
      font-size: 0.75rem;
      font-weight: 600;
      font-style: normal;
      line-height: 1;
    }
  }
  @media screen and (min-width: 48rem) {
    .tldr .num-list > li {
      font-size: 1.0625rem;
    }
  }

  /* PDF: a tinted "in brief" box with the four points in two columns */
  @media print {
    .tldr {
      padding: 5mm 6mm;
      border: 0;
      border-block-start: 2.5pt solid var(--heading);
      border-radius: 0;
      background: var(--color-sky-50);
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .num-list {
      grid-template-columns: 1fr 1fr;
      gap: 3.5mm 7mm;
      margin-block-start: 3.5mm;
      font-size: 9.5pt;
      line-height: 1.45;
    }
  }
</style>
