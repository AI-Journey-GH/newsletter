---
// Sticky section jump links under the header. Horizontally scrollable on phones.
interface Props {
  items: { id: string; label: string }[];
  class?: string;
}
const { items, class: className } = Astro.props;
---

<nav class:list={['chips-bar', className]} aria-label="Jump to section" data-chips>
  <div class="wrap-read">
    <ul class="no-scrollbar flex gap-2 overflow-x-auto py-2.5" data-chips-scroller>
      {
        items.map((item) => (
          <li class="shrink-0">
            <a href={`#${item.id}`} class="chip" data-chip={item.id}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  .chips-bar {
    position: sticky;
    inset-block-start: var(--header-h-condensed);
    min-inline-size: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-block-end: 1px solid var(--border);
  }
  .chips-bar ul {
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--gutter);
    /* let the row bleed to the screen edge on phones */
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    padding-block: 0.5rem;
  }
  .chips-bar li {
    scroll-snap-align: start;
  }
  .chips-bar .chip {
    min-height: 2.75rem;
    font-size: 0.8125rem;
  }
  @media screen and (min-width: 72rem) {
    .chips-bar {
      align-self: start;
      inset-block-start: calc(var(--header-h-condensed) + 2rem);
      margin-block-start: 0;
      background: transparent;
      backdrop-filter: none;
      border-block-end: 0;
    }
    .chips-bar .wrap-read {
      max-inline-size: none;
      padding: 0;
      font-size: 1rem;
      line-height: 1.5;
    }
    .chips-bar ul {
      flex-direction: column;
      gap: 0.375rem;
      max-block-size: calc(100dvh - var(--header-h-condensed) - 4rem);
      margin: 0;
      padding: 0;
      overflow-x: visible;
      overflow-y: auto;
      scroll-snap-type: none;
      scrollbar-width: thin;
      scrollbar-color: var(--border-strong) transparent;
    }
    .chips-bar li {
      scroll-snap-align: none;
    }
    .chips-bar .chip {
      justify-content: start;
      inline-size: 100%;
      padding: 0.625rem 0.875rem;
      border-color: transparent;
      border-radius: 0.5rem;
      color: var(--muted);
      line-height: 1.5;
      white-space: normal;
    }
    .chips-bar .chip:hover {
      background: var(--surface-2);
      color: var(--heading);
    }
    .chips-bar .chip:focus-visible {
      outline-offset: -2px;
    }
    .chips-bar .chip[aria-current='true'] {
      border-inline-start-color: var(--deco);
      background: var(--bg-alt);
      color: var(--heading);
      font-weight: 650;
    }
  }
</style>

<script>
  // Highlight the chip for the section currently on screen
  const chips = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-chip]').forEach((c) => chips.set(c.dataset.chip!, c));
  const scroller = document.querySelector<HTMLElement>('[data-chips-scroller]');
  const wide = window.matchMedia('(min-width: 72rem)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let current = '';
  const centerCurrent = () => {
    const chip = chips.get(current);
    if (!scroller || !chip || wide.matches) return;
    const left = scroller.scrollLeft + chip.getBoundingClientRect().left - scroller.getBoundingClientRect().left - (scroller.clientWidth - chip.clientWidth) / 2;
    scroller.scrollTo({ left, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
  };
  const setCurrent = (id: string) => {
    if (id === current) return;
    current = id;
    chips.forEach((chip, key) => {
      if (key === id) {
        chip.setAttribute('aria-current', 'true');
      } else chip.removeAttribute('aria-current');
    });
    centerCurrent();
  };
  // The current section is the last one whose top has passed just under the sticky bar
  const bar = document.querySelector<HTMLElement>('[data-chips]');
  const sections = [...chips.keys()].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  let queued = false;
  let recenterOnUpdate = false;
  const update = () => {
    queued = false;
    const rect = bar?.getBoundingClientRect();
    const line = (wide.matches ? rect?.top ?? 0 : rect?.bottom ?? 0) + window.innerHeight * 0.25;
    let id = sections[0]?.id ?? '';
    for (const s of sections) if (s.getBoundingClientRect().top <= line) id = s.id;
    const changed = id !== current;
    setCurrent(id);
    if (recenterOnUpdate && !changed) centerCurrent();
    recenterOnUpdate = false;
  };
  window.addEventListener(
    'scroll',
    () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true },
  );
  window.addEventListener('resize', () => {
    recenterOnUpdate = true;
    if (!queued) {
      queued = true;
      requestAnimationFrame(update);
    }
  }, { passive: true });
  update();
</script>
