---
import CategoryTag from '../CategoryTag.astro';
import Callout from '../Callout.astro';
import Figure from '../Figure.astro';
import Icon from '../Icon.astro';
import KeyStat from '../KeyStat.astro';
import SectionHead from './SectionHead.astro';
import type { Issue } from '../../lib/utils';
import { md } from '../../lib/utils';

interface Props {
  story: Issue['data']['bigStory'];
}
const { story } = Astro.props;
---

<section id="big-story" aria-labelledby="big-story-title">
  <SectionHead id="big-story-label" eyebrow="The Big Story">
    <div><CategoryTag tag={story.tag} /></div>
  </SectionHead>

  {story.image && <Figure src={story.image.src} alt={story.image.alt} credit={story.image.credit} class="mt-6" />}

  <h2 id="big-story-title" class="display h-section mt-5">{story.headline}</h2>
  <p class="mt-5 text-[1.08em] font-semibold leading-normal text-heading" set:html={md(story.lead)} />

  <div class="prose mt-5">
    <slot />
  </div>

  {
    story.keyNumbers.length > 0 && (
      <aside class="mt-12" aria-label="Key numbers">
        <p class="eyebrow eyebrow--line">Key numbers</p>
        <div
          class:list={[
            'mt-5 grid gap-6',
            story.keyNumbers.length > 1 && 'sm:grid-cols-2',
            story.keyNumbers.length === 3 && 'md:grid-cols-3',
          ]}
        >
          {story.keyNumbers.map((k) => (
            <KeyStat value={k.value} label={k.label} />
          ))}
        </div>
      </aside>
    )
  }

  <Callout variant="why" title="Why it matters to you" class="mt-10">
    <p set:html={md(story.whyItMatters)} />
  </Callout>

  {
    story.goDeeper.length > 0 && (
      <div class="mt-10">
        <p class="eyebrow eyebrow--line">Go deeper</p>
        <ul class="mt-3">
          {story.goDeeper.map((l) => (
            <li class="border-b border-line">
              <a href={l.url} class="deeper-link" target="_blank" rel="noopener">
                <span>{l.label}</span>
                <Icon name="external" size={16} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</section>

<style>
  .deeper-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.25rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--heading);
  }
  .deeper-link:hover {
    color: var(--link);
  }
  .deeper-link :global(svg) {
    flex: none;
    color: var(--muted);
  }
</style>
