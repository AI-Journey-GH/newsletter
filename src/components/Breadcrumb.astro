---
import Icon from './Icon.astro';
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-sm">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-1.5">
          {item.href ? (
            <a href={item.href} class="inline-flex min-h-8 items-center text-muted no-underline hover:text-heading">
              {item.label}
            </a>
          ) : (
            <span aria-current="page" class="text-heading">{item.label}</span>
          )}
          {i < items.length - 1 && <Icon name="chevron-right" size={14} class="text-muted rtl:rotate-180" />}
        </li>
      ))
    }
  </ol>
</nav>
