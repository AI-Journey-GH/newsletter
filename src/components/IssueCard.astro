---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { formatDate, isoDate, issueUrl, type Issue } from '../lib/utils';

interface Props {
  issue: Issue;
  headingLevel?: 'h2' | 'h3';
}
const { issue, headingLevel: H = 'h3' } = Astro.props;
const { data } = issue;
const num = String(data.issue).padStart(2, '0');
---

<article class="issue-row">
  <div class="issue-index" aria-hidden="true">
    {data.cover ? <Image src={data.cover.src} alt="" widths={[80, 160]} sizes="80px" loading="lazy" class="row-cover" /> : <><Icon name="newspaper" size={21} /><span>{num}</span></>}
  </div>
  <div class="issue-content">
    <p class="issue-meta"><span>Issue {num}</span><span aria-hidden="true">·</span><time datetime={isoDate(data.date)}>{formatDate(data.date, 'short')}</time><span aria-hidden="true">·</span><span>{data.readTime} min read</span></p>
    <H class="display row-title"><a href={issueUrl(issue)} class="row-link">{data.title}</a></H>
    <p class="row-description">{data.subtitle}</p>
  </div>
  <span class="row-action" aria-hidden="true"><Icon name="arrow-right" size={20} /></span>
</article>

<style>
  .issue-row { position: relative; display: grid; grid-template-columns: 3rem minmax(0, 1fr); align-items: center; gap: 1rem; padding-block: 1.5rem; }
  .issue-index { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.375rem; inline-size: 3rem; block-size: 3.75rem; border: 1px solid var(--border); border-radius: 0.5rem; background: var(--bg-alt); color: var(--accent); font-size: 0.75rem; font-weight: 600; }
  .issue-content { min-inline-size: 0; }
  .row-cover { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; border-radius: 0.5rem; }
  .issue-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.375rem; color: var(--muted); font-size: 0.6875rem; line-height: 1.65; }
  .issue-meta > span:last-child { white-space: nowrap; }
  .row-title { margin-block-start: 0.5rem; font-size: clamp(1.125rem, 1rem + 0.6vw, 1.625rem); font-weight: 700; line-height: 1.35; letter-spacing: -0.035em; }
  .row-link { color: var(--heading); text-decoration: none; }
  .row-link::after { content: ''; position: absolute; inset: 0; }
  .row-link:focus-visible { outline: none; }
  .issue-row:focus-within { outline: 2px solid var(--focus); outline-offset: 4px; border-radius: 0.5rem; }
  .row-description { margin-block-start: 0.5rem; color: var(--muted); font-size: 0.875rem; line-height: 1.65; }
  .row-action { display: none; align-items: center; justify-content: center; inline-size: 2.75rem; block-size: 2.75rem; color: var(--heading); transition: transform 150ms ease; }
  .issue-row:hover .row-title a { text-decoration: underline; text-underline-offset: 0.2em; text-decoration-thickness: 1px; }
  .issue-row:hover .row-action { transform: translateX(3px); }
  @media (min-width: 48rem) {
    .issue-row { grid-template-columns: 4rem minmax(0, 1fr) 2.75rem; gap: 1.5rem; padding-block: 1.75rem; }
    .issue-index { inline-size: 4rem; block-size: 4rem; flex-direction: row; gap: 0.5rem; font-size: 0.8125rem; }
    .issue-meta { font-size: 0.75rem; }
    .row-action { display: inline-flex; }
  }
</style>
