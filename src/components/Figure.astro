---
// Image with a small italic caption and credit. Only used when an editor adds a picture.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: string;
  ratio?: string;
  widths?: number[];
  sizes?: string;
  class?: string;
}
const {
  src,
  alt,
  caption,
  credit,
  ratio = '16 / 9',
  widths = [360, 720, 1080, 1440],
  sizes = '(min-width: 768px) 720px, 100vw',
  class: className,
} = Astro.props;
---

<figure class={className}>
  <div class="overflow-hidden rounded-xl bg-surface-2" style={{ aspectRatio: ratio }}>
    <Image src={src} alt={alt} widths={widths} sizes={sizes} loading="lazy" class="h-full w-full object-cover" />
  </div>
  {
    (caption || credit) && (
      <figcaption class="caption mt-2 text-center">
        {caption}
        {caption && credit && ' '}
        {credit && <span>Credit: {credit}</span>}
      </figcaption>
    )
  }
</figure>
