---
import Icon from './Icon.astro';
import { nav, site, social } from '../config';
import { u } from '../lib/utils';
---

<footer class="site-footer no-print">
  <div class="wrap footer-main">
    <div class="footer-identity">
      <a href={u('/')} class="footer-brand" aria-label={`${site.name} home`}>
        <img src={u('/logo/mark-navy-cyan-sm.webp')} alt="" width="160" height="85" class="only-light" loading="lazy" decoding="async" />
        <img src={u('/logo/mark-light-sm.webp')} alt="" width="160" height="85" class="only-dark" loading="lazy" decoding="async" />
        <span>AI Journey</span>
      </a>
      <p>Curious minds. Shared ideas.<br />A student community at AUB.</p>
    </div>
    <div class="footer-explore">
      <p class="eyebrow">Explore</p>
      <nav aria-label="Footer"><ul class="footer-nav">{nav.map((item) => <li><a href={u(item.href)}>{item.label}</a></li>)}</ul></nav>
    </div>
    <div class="footer-connect">
      <p class="eyebrow">Keep in touch</p>
      <ul class="footer-socials" aria-label="Social links">
        {social.map((s) => <li><a href={s.href} class="icon-btn" target="_blank" rel="noopener" aria-label={`${site.name} on ${s.label}`}><Icon name={s.icon} size={21} /></a></li>)}
        <li><a href={u('/rss.xml')} class="icon-btn" aria-label="Subscribe with RSS"><Icon name="rss" size={21} /></a></li>
      </ul>
    </div>
  </div>
  <div class="wrap footer-bottom"><p>© {new Date().getFullYear()} AI Journey.</p><p>Made by students, for students.</p></div>
</footer>

<style>
  .site-footer { border-block-start: 1px solid var(--border); }
  .footer-main { display: grid; gap: 2rem; padding-block: 2.5rem; }
  .footer-brand { display: inline-flex; align-items: center; gap: 0.75rem; color: var(--heading); text-decoration: none; font-family: var(--font-display); font-size: 1.375rem; font-weight: 750; letter-spacing: -0.05em; }
  .footer-brand img { inline-size: 3rem; block-size: auto; }
  .footer-identity p { margin-block-start: 1rem; color: var(--muted); font-size: 0.875rem; line-height: 1.7; }
  .footer-nav { display: grid; gap: 0.125rem; margin-block-start: 0.5rem; }
  .footer-nav a { display: inline-flex; align-items: center; min-block-size: 2.75rem; color: var(--heading); text-decoration: none; font-size: 0.875rem; }
  .footer-nav a:hover { text-decoration: underline; text-underline-offset: 0.3em; }
  .footer-socials { display: flex; gap: 0.125rem; margin-block-start: 0.5rem; }
  .footer-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1.5rem; padding-block: 1.25rem; border-block-start: 1px solid var(--border); color: var(--muted); font-size: 0.75rem; }
  @media (min-width: 30rem) { .footer-main { grid-template-columns: repeat(2, minmax(0, 1fr)); } .footer-identity { grid-column: 1 / -1; } }
  @media (min-width: 48rem) { .footer-main { grid-template-columns: 1.5fr 1fr 1fr; gap: 3rem; padding-block: 3rem; } .footer-identity { grid-column: auto; } .footer-connect { justify-self: end; } }
</style>
