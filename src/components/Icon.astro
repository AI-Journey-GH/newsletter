---
import { icons } from '@iconify-json/ph';

interface Props {
  name: string;
  size?: number;
  class?: string;
  label?: string;
}

const names: Record<string, string> = {
  menu: 'list', search: 'magnifying-glass', x: 'x', sun: 'sun', moon: 'moon', 'arrow-left': 'arrow-left',
  'arrow-right': 'arrow-right', 'arrow-up': 'arrow-up', 'chevron-right': 'caret-right',
  share: 'share-network', link: 'link', external: 'arrow-up-right', check: 'check',
  'check-circle': 'check-circle', grid: 'squares-four', clock: 'clock', calendar: 'calendar-blank',
  mail: 'envelope-simple', send: 'paper-plane-tilt', rss: 'rss', zap: 'lightning',
  list: 'list-bullets', newspaper: 'newspaper', wrench: 'wrench', lightbulb: 'lightbulb',
  vote: 'check-square', briefcase: 'briefcase', users: 'users', book: 'book-open',
  target: 'target', shield: 'shield-check', tag: 'tag', dollar: 'currency-dollar',
  download: 'download-simple', copy: 'copy', cpu: 'cpu', mic: 'microphone',
  alert: 'warning', flask: 'flask', file: 'file-text', scale: 'scales', sparkles: 'sparkle',
  instagram: 'instagram-logo', whatsapp: 'whatsapp-logo', linkedin: 'linkedin-logo',
};
const { name, size = 20, class: className, label } = Astro.props;
const icon = icons.icons[names[name] ?? name] ?? icons.icons.sparkle;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${icon.width ?? icons.width ?? 256} ${icon.height ?? icons.height ?? 256}`}
  width={size}
  height={size}
  fill="currentColor"
  class={className}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={icon.body}
/>
