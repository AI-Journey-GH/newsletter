---
import { Image } from 'astro:assets';
import panelPhoto from '../assets/community/frontier-panel.jpg';
import crowdPhoto from '../assets/community/frontier-crowd.jpg';

interface Props {
  view?: 'panel' | 'community';
  priority?: boolean;
  sizes?: string;
}

const { view = 'panel', priority = false, sizes = '(min-width: 1024px) 50vw, (min-width: 640px) 90vw, 150vw' } = Astro.props;
const src = view === 'panel' ? panelPhoto : crowdPhoto;
const alt = view === 'panel'
  ? 'Researchers and student moderators in conversation at the Two Labs, One Frontier event at AUB'
  : 'AI Journey students and speakers together after Two Labs, One Frontier at AUB';
---

<div class:list={['community-photo', `community-photo--${view}`]}>
  <Image
    src={src}
    alt={alt}
    widths={[640, 960, 1440, 1920]}
    sizes={sizes}
    format="webp"
    quality={82}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    class="community-photo-image"
  />
</div>

<style>
  .community-photo { position: relative; overflow: hidden; aspect-ratio: 2.42; background: var(--surface-2); }
  .community-photo :global(.community-photo-image) { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; object-position: center; }
  .community-photo--community :global(.community-photo-image) { object-position: center 70%; }
</style>
