---
import Icon from './Icon.astro';
import { links, nav, social, site } from '../config';
import { u } from '../lib/utils';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  if (href.includes('#')) return false;
  const target = u(href).replace(/\/$/, '') || '/';
  return path === target || path.startsWith(`${target}/`);
};
---

<header class="site-header no-print" data-header>
  <div class="wrap header-inner">
    <a href={u('/')} class="brand" aria-label={`${site.name} home`}>
      <img src={u('/logo/mark-navy-cyan-sm.webp')} alt="" width="160" height="85" class="brand-mark only-light" decoding="async" />
      <img src={u('/logo/mark-light-sm.webp')} alt="" width="160" height="85" class="brand-mark only-dark" decoding="async" />
      <span class="brand-word">AI Journey</span>
    </a>
    <nav class="desktop-nav" aria-label="Main">
      <ul>{nav.map((item) => <li><a href={u(item.href)} class="nav-link" aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>)}</ul>
    </nav>
    <div class="header-actions">
      <button type="button" class="icon-btn theme-toggle" data-theme-toggle aria-label="Switch color theme">
        <Icon name="moon" size={19} class="theme-icon-moon" />
        <Icon name="sun" size={19} class="theme-icon-sun" />
      </button>
      <a href={links.whatsapp} class="btn btn-primary header-join" target="_blank" rel="noopener">Join AI Journey <Icon name="arrow-right" size={18} /></a>
      <button type="button" class="icon-btn menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
        <Icon name="menu" size={23} class="menu-icon-open" />
        <Icon name="x" size={23} class="menu-icon-close" />
      </button>
    </div>
  </div>
  <div id="mobile-menu" class="mobile-menu" hidden data-menu>
    <nav class="wrap mobile-nav" aria-label="Mobile">
      <ul>{nav.map((item) => <li><a href={u(item.href)} class="mobile-link display" aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}<Icon name="arrow-right" size={22} /></a></li>)}</ul>
      <a href={links.whatsapp} class="btn btn-primary mobile-join" target="_blank" rel="noopener">Join the community <Icon name="arrow-right" size={18} /></a>
      <ul class="mobile-socials" aria-label="Social links">{social.map((s) => <li><a href={s.href} class="icon-btn" target="_blank" rel="noopener" aria-label={s.label}><Icon name={s.icon} size={21} /></a></li>)}</ul>
    </nav>
  </div>
</header>
<style>
  .site-header { position: sticky; inset-block-start: 0; z-index: 50; block-size: var(--header-h); background: var(--bg); color: var(--text); border-block-end: 1px solid transparent; transition: border-color 150ms ease; }
  .site-header.is-scrolled { border-block-end-color: var(--border); }
  .header-inner { display: flex; align-items: center; block-size: 100%; gap: 1rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.625rem; color: var(--heading); text-decoration: none; flex: none; }
  .brand-mark { inline-size: 2.75rem; block-size: auto; }
  .brand-word { font-family: var(--font-display); font-size: 1.25rem; font-weight: 750; letter-spacing: -0.055em; line-height: 1; white-space: nowrap; }
  .desktop-nav { display: none; margin-inline-start: auto; }
  .desktop-nav ul { display: flex; align-items: center; gap: 0.25rem; }
  .nav-link { display: inline-flex; align-items: center; min-block-size: 2.75rem; padding-inline: 0.75rem; color: var(--heading); text-decoration: none; font-size: 0.9375rem; }
  .nav-link:hover, .nav-link[aria-current='page'] { text-decoration: underline; text-underline-offset: 0.5em; text-decoration-color: var(--deco); text-decoration-thickness: 2px; }
  .header-actions { display: flex; align-items: center; gap: 0.25rem; margin-inline-start: auto; }
  .header-join { display: none; white-space: nowrap; }
  .mobile-menu { position: absolute; inset-block-start: 100%; inset-inline: 0; max-block-size: calc(100dvh - var(--header-h)); overflow-y: auto; background: var(--bg); border-block: 1px solid var(--border); }
  .mobile-nav { padding-block: 0.5rem 1.5rem; }
  .mobile-link { display: flex; align-items: center; justify-content: space-between; min-block-size: 3.75rem; border-block-end: 1px solid var(--border); color: var(--heading); text-decoration: none; font-size: 1.5rem; }
  .mobile-link[aria-current='page'] { color: var(--accent); }
  .mobile-join { margin-block-start: 1.5rem; }
  .mobile-socials { display: flex; gap: 0.25rem; margin-block-start: 1rem; }
  :global(.menu-icon-close), :global([aria-expanded='true'] .menu-icon-open), :global([data-theme='dark'] .theme-icon-moon), :global(:root:not([data-theme='dark']) .theme-icon-sun) { display: none; }
  :global([aria-expanded='true'] .menu-icon-close) { display: block; }
  @media (min-width: 48rem) {
    .brand-mark { inline-size: 3.625rem; }
    .brand-word { font-size: 1.5rem; }
    .desktop-nav { display: block; }
    .header-actions { margin-inline-start: 0.25rem; gap: 0.5rem; }
    .menu-toggle, .mobile-menu { display: none; }
  }
  @media (min-width: 64rem) { .header-join { display: inline-flex; margin-inline-start: 0.5rem; } }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      header?.classList.toggle('is-scrolled', window.scrollY > 8);
      ticking = false;
    });
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  const setMenu = (open: boolean) => {
    if (!menuBtn || !menu) return;
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu.hidden = !open;
  };
  menuBtn?.addEventListener('click', () => setMenu(menuBtn.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setMenu(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuBtn?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      menuBtn.focus();
    }
  });
  document.addEventListener('click', (event) => {
    if (event.target instanceof Node && !header?.contains(event.target)) setMenu(false);
  });
  window.matchMedia('(min-width: 48rem)').addEventListener('change', (event) => event.matches && setMenu(false));
  const root = document.documentElement;
  const labelTheme = () => {
    const dark = root.getAttribute('data-theme') === 'dark';
    themeBtn?.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
    themeBtn?.setAttribute('aria-pressed', String(dark));
  };
  themeBtn?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch {}
    labelTheme();
  });
  labelTheme();
</script>
