---
interface Props {
  name?: string;
  role?: string;
}
const { name, role } = Astro.props;
---

<figure class="border-t border-line pt-6">
  <blockquote class="display text-[1.75rem] italic leading-tight md:text-[2.25rem]">“<slot />”</blockquote>
  {
    name && (
      <figcaption class="mt-4 text-sm">
        <span class="font-semibold text-heading">{name}</span>
        {role && <span class="text-muted">, {role}</span>}
      </figcaption>
    )
  }
</figure>
