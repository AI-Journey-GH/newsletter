---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Icon from '../components/Icon.astro';
import NextUp from '../components/NextUp.astro';
import { links } from '../config';
import { activities, activityPath, materialIcon } from '../data/activities';
import { tracks } from '../data/learn';
import { u } from '../lib/utils';

const steps = tracks
  .map((track) => ({ ...track, activity: activities.find((activity) => activity.id === track.activityId) }))
  .filter((step) => step.activity);
---

<BaseLayout title="Learn" description="A learning path through AI from AI Journey at AUB: the sessions we ran, from first steps to transformers, with free reading we recommend at each step.">
  <div class="wrap learn-page">
    <Breadcrumb items={[{ label: 'Home', href: u('/') }, { label: 'Learn' }]} />

    <section class="learn-intro" aria-labelledby="learn-title">
      <p class="eyebrow">Learn with AI Journey</p>
      <h1 id="learn-title" class="display learn-title">A path through AI, one session at a time.</h1>
      <p class="learn-description">Our sessions build on each other. Start at the foundations, or jump in where you are. Each step links to the session we ran and to free resources we recommend.</p>
      <nav class="step-jump" aria-label="Learning steps">
        {steps.map((step, index) => (
          <a href={`#${step.id}`}><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>{step.title}</a>
        ))}
      </nav>
    </section>

    <ol class="path">
      {steps.map((step, index) => {
        const activity = step.activity!;
        return (
          <li id={step.id} class="step">
            <div class="step-marker" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
            <article class="step-card" aria-labelledby={`${step.id}-title`}>
              <header class="step-head">
                <p class="step-level">{step.level}</p>
                <h2 id={`${step.id}-title`} class="display step-title">{step.title}</h2>
                <p class="step-description">{step.description}</p>
              </header>

              <div class="step-grid">
                <div class="step-session">
                  <h3 class="step-label">From our sessions</h3>
                  <a href={u(activityPath(activity))} class="session-link">
                    <span class="session-thumb">
                      <Image src={activity.cover.src} alt="" widths={[160, 320]} sizes="5rem" format="webp" quality={80} loading="lazy" />
                    </span>
                    <span class="session-copy">
                      <span class="session-meta">{activity.category} · {activity.periodLabel}</span>
                      <span class="session-title">{activity.title}</span>
                    </span>
                    <Icon name="arrow-right" size={18} class="session-arrow" />
                  </a>
                  <ul class="topic-chips" aria-label={`Topics in ${activity.title}`}>
                    {activity.topics.map((topic) => <li>{topic}</li>)}
                  </ul>
                  {activity.materials && activity.materials.length > 0 && (
                    <ul class="material-links">
                      {activity.materials.map((item) => (
                        <li><a href={item.href} target="_blank" rel="noopener"><Icon name={materialIcon[item.kind]} size={17} />{item.label}</a></li>
                      ))}
                    </ul>
                  )}
                </div>

                <div class="step-reading">
                  <h3 class="step-label">Recommended reading</h3>
                  <ul class="reading-list">
                    {step.reading.map((item) => (
                      <li>
                        <a href={item.href} target="_blank" rel="noopener" class="reading-link">
                          <span class="reading-kind">{item.kind}</span>
                          <span class="reading-title">{item.title}<Icon name="external" size={14} /></span>
                          <span class="reading-by">{item.by}</span>
                          <span class="reading-note">{item.note}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </article>
          </li>
        );
      })}
    </ol>

    <aside class="suggest" aria-labelledby="suggest-title">
      <span class="suggest-icon"><Icon name="lightbulb" size={24} /></span>
      <div>
        <h2 id="suggest-title" class="suggest-title">Found something that helped you learn?</h2>
        <p>Share it in the community. The best suggestions end up on this page.</p>
      </div>
      <a href={links.whatsapp} class="btn btn-primary" target="_blank" rel="noopener"><Icon name="whatsapp" size={19} />Suggest a resource</a>
    </aside>

    <NextUp id="learn-next" />
  </div>
</BaseLayout>

<style>
  .learn-page { padding-block: 1.5rem 4rem; }
  .learn-intro { padding-block: 2.5rem 2.5rem; }
  .learn-title { max-inline-size: 18ch; margin-block-start: 0.875rem; font-size: clamp(2.25rem, 1.35rem + 3.5vw, 4rem); font-weight: 730; line-height: 1.1; letter-spacing: -0.045em; text-wrap: balance; }
  .learn-description { max-inline-size: 40rem; margin-block-start: 1.25rem; color: var(--muted); font-size: 1.0625rem; line-height: 1.75; }
  .step-jump { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-block-start: 1.75rem; }
  .step-jump a { display: inline-flex; align-items: center; gap: 0.5rem; min-block-size: 2.75rem; padding: 0.5rem 0.875rem; border: 1px solid var(--border-strong); border-radius: 999px; color: var(--heading); font-size: 0.8125rem; font-weight: 550; text-decoration: none; }
  .step-jump a:hover { border-color: var(--heading); }
  .step-jump span { color: var(--accent); font-weight: 700; font-variant-numeric: tabular-nums; }
  .path { display: grid; gap: 1.5rem; }
  .step { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); scroll-margin-top: calc(var(--header-h) + 1rem); }
  .step-marker { display: none; }
  .step-card { min-inline-size: 0; padding: 1.25rem; border: 1px solid var(--border); border-radius: 1rem; background: var(--surface); }
  .step-level { color: var(--accent); font-size: 0.75rem; font-weight: 650; letter-spacing: 0.1em; text-transform: uppercase; }
  .step-title { margin-block-start: 0.5rem; font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem); font-weight: 700; line-height: 1.2; letter-spacing: -0.035em; }
  .step-description { max-inline-size: 42rem; margin-block-start: 0.75rem; color: var(--muted); font-size: 0.9375rem; line-height: 1.75; }
  .step-grid { display: grid; gap: 1.75rem; margin-block-start: 1.5rem; padding-block-start: 1.5rem; border-block-start: 1px solid var(--border); }
  .step-session, .step-reading { min-inline-size: 0; }
  .step-label { color: var(--muted); font-size: 0.75rem; font-weight: 650; letter-spacing: 0.08em; text-transform: uppercase; }
  .session-link { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 0.875rem; margin-block-start: 0.875rem; padding: 0.625rem; border: 1px solid var(--border); border-radius: 0.875rem; background: var(--bg-alt); color: var(--heading); text-decoration: none; transition: border-color 150ms ease; }
  .session-link:hover { border-color: var(--border-strong); }
  .session-link:hover :global(.session-arrow) { transform: translateX(3px); }
  .session-thumb { display: block; overflow: hidden; inline-size: 4.5rem; block-size: 4.5rem; border-radius: 0.5rem; background: #182b49; }
  .session-thumb :global(img) { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; object-position: top; }
  .session-copy { display: grid; gap: 0.25rem; min-inline-size: 0; }
  .session-meta { color: var(--muted); font-size: 0.75rem; }
  .session-title { font-family: var(--font-display); font-size: 1.0625rem; font-weight: 700; line-height: 1.3; letter-spacing: -0.02em; }
  .session-link :global(.session-arrow) { flex: none; transition: transform 180ms ease; }
  .topic-chips { display: flex; flex-wrap: wrap; gap: 0.375rem; margin-block-start: 0.875rem; }
  .topic-chips li { padding: 0.25rem 0.625rem; border-radius: 999px; background: var(--surface-2); color: var(--heading); font-size: 0.75rem; font-weight: 550; }
  .material-links { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; margin-block-start: 0.875rem; }
  .material-links a { display: inline-flex; align-items: center; gap: 0.375rem; min-block-size: 2.75rem; font-size: 0.875rem; font-weight: 550; }
  .reading-list { display: grid; gap: 0.625rem; margin-block-start: 0.875rem; }
  .reading-link { display: grid; gap: 0.125rem; padding: 0.875rem 1rem; border: 1px solid var(--border); border-radius: 0.875rem; color: var(--text); text-decoration: none; transition: border-color 150ms ease, background-color 150ms ease; }
  .reading-link:hover { border-color: var(--border-strong); background: var(--bg-alt); color: var(--text); }
  .reading-kind { color: var(--accent); font-size: 0.6875rem; font-weight: 650; letter-spacing: 0.08em; text-transform: uppercase; }
  .reading-title { display: inline-flex; align-items: center; gap: 0.375rem; margin-block-start: 0.25rem; color: var(--heading); font-size: 1rem; font-weight: 650; line-height: 1.4; }
  .reading-title :global(svg) { flex: none; color: var(--muted); }
  .reading-by { color: var(--muted); font-size: 0.8125rem; }
  .reading-note { margin-block-start: 0.375rem; font-size: 0.875rem; line-height: 1.65; }
  .suggest { display: grid; gap: 1rem; margin-block: 2.5rem 1rem; padding: 1.5rem; border-radius: 1rem; background: var(--bg-alt); }
  .suggest-icon { display: inline-flex; align-items: center; justify-content: center; inline-size: 3rem; block-size: 3rem; border-radius: 0.75rem; background: var(--surface); color: var(--accent); }
  .suggest-title { color: var(--heading); font-family: var(--font-display); font-size: 1.25rem; font-weight: 700; line-height: 1.3; letter-spacing: -0.025em; }
  .suggest p { margin-block-start: 0.375rem; color: var(--muted); font-size: 0.9375rem; line-height: 1.7; }
  .suggest .btn { justify-self: start; min-block-size: 3rem; gap: 0.5rem; }
  @media (min-width: 48rem) {
    .path { gap: 2rem; }
    .step { grid-template-columns: 3.5rem minmax(0, 1fr); gap: 1.25rem; }
    .step::before { content: ''; position: absolute; inset-block: 3.5rem -2rem; inset-inline-start: 1.75rem; inline-size: 2px; background: var(--border-strong); translate: -50% 0; }
    .step:last-child::before { display: none; }
    .step-marker { position: relative; display: flex; align-items: center; justify-content: center; inline-size: 3.5rem; block-size: 3.5rem; border-radius: 999px; background: var(--btn-bg); color: var(--btn-fg); font-family: var(--font-display); font-size: 1.0625rem; font-weight: 750; }
    .step-card { padding: 1.75rem; }
    .suggest { grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 1.5rem; padding: 1.5rem 1.75rem; }
    .suggest .btn { justify-self: end; }
  }
  @media (min-width: 64rem) {
    .learn-page { padding-block: 2rem 5rem; }
    .learn-intro { padding-block: 3rem 3.5rem; }
    .step-grid { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 2.5rem; }
  }
</style>
