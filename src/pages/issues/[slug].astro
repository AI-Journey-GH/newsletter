---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import SampleBadge from '../../components/SampleBadge.astro';
import ActionBar from '../../components/issue/ActionBar.astro';
import BigStory from '../../components/issue/BigStory.astro';
import PrevNext from '../../components/issue/PrevNext.astro';
import QuickHits from '../../components/issue/QuickHits.astro';
import ReadingProgress from '../../components/issue/ReadingProgress.astro';
import SectionChips from '../../components/issue/SectionChips.astro';
import Tldr from '../../components/issue/Tldr.astro';
import ToolCard from '../../components/issue/ToolCard.astro';
import Wildcard from '../../components/issue/Wildcard.astro';
import YourTurn from '../../components/issue/YourTurn.astro';
import { site } from '../../config';
import { formatDate, getIssues, isoDate, issueUrl, md, mdBlock, plain, u, type Issue } from '../../lib/utils';
import { getImage } from 'astro:assets';

export async function getStaticPaths() {
  const issues = await getIssues();
  return issues.map((issue, i) => ({
    params: { slug: issue.id },
    props: { issue, newer: issues[i - 1], older: issues[i + 1] },
  }));
}

interface Props {
  issue: Issue;
  newer?: Issue;
  older?: Issue;
}
const { issue, newer, older } = Astro.props;
const { Content, headings } = await render(issue);
const d = issue.data;
const url = new URL(issueUrl(issue), Astro.site).href;
const shareTitle = `AI Journey Issue #${d.issue}: ${d.title}`;
const ogImage = d.cover ? (await getImage({ src: d.cover.src, width: 1200, height: 630, fit: 'cover' })).src : undefined;

// Issues either use the fixed sections (Big Story, Quick Hits, Tool, Wildcard)
// or tell the news as "## Brief 1: ..." sections in the Markdown body.
const storyHeadings = d.bigStory ? [] : headings.filter((h) => h.depth === 2);
const chips = [
  { id: 'thirty-seconds', label: '30 Seconds' },
  ...(d.bigStory ? [{ id: 'big-story', label: 'Big Story' }] : []),
  ...storyHeadings.map((h) => ({ id: h.slug, label: h.text.split(':')[0].trim() })),
  ...(d.quickHits ? [{ id: 'quick-hits', label: 'Quick Hits' }] : []),
  ...(d.tool ? [{ id: 'tool', label: 'Tool' }] : []),
  ...(d.wildcard ? [{ id: 'wildcard', label: 'Wildcard' }] : []),
  ...(d.yourTurn ? [{ id: 'your-turn', label: 'Your Turn' }] : []),
];
---

<BaseLayout
  title={`Issue #${d.issue}: ${d.title}`}
  description={plain(d.subtitle)}
  type="article"
  publishedTime={d.date}
  image={ogImage}
  withActionBar
>
  <ReadingProgress slot="top" />

  <article data-article>
    <div class="wrap-mast pt-6 md:pt-10">
      <div class="no-print">
        <Breadcrumb items={[{ label: 'Home', href: u('/') }, { label: 'Blogs', href: u('/issues') }, { label: `Issue ${d.issue}` }]} />
      </div>

      <!-- Only in the PDF: newsletter nameplate and dateline -->
      <div class="print-mast">
        <p class="pm-name">
          <img src={u('/logo/mark-navy-cyan-sm.webp')} alt="" width="160" height="85" />
          <span class="display">AI Journey</span>
        </p>
        <p class="pm-tag">{site.tagline}</p>
        <p class="pm-dateline">
          <span>Issue {d.issue}</span>
          <span>{formatDate(d.date)}</span>
          <span>{d.readTime} min read</span>
        </p>
      </div>

      <header class="issue-head">
        <div class="flex flex-wrap items-center gap-3">
          <p class="eyebrow eyebrow--line no-print">The weekly read / Issue {String(d.issue).padStart(2, '0')}</p>
          {d.sample && <SampleBadge />}
        </div>
        <h1 class="display issue-title">{d.title}</h1>
        <p class="lead issue-deck">{d.subtitle}</p>
        <div class="issue-byline no-print">
          <p class="issue-author">By <span>{d.author}</span></p>
          <div class="issue-dateline">
            <time datetime={isoDate(d.date)}>{formatDate(d.date, 'short')}</time>
            <span aria-hidden="true">·</span>
            <span>{d.readTime} min read</span>
          </div>
        </div>
      </header>
    </div>

    <SectionChips items={chips} class="no-print mt-6" />

    <div class="wrap-read issue-sections mt-10 grid gap-10 pb-16 md:mt-12 md:gap-14">
      {d.intro && <div class="prose intro" set:html={mdBlock(d.intro)} />}
      <Tldr items={d.tldr} />
      {
        d.bigStory ? (
          <BigStory story={d.bigStory}>
            <Content />
          </BigStory>
        ) : (
          <div class="prose stories">
            <Content />
          </div>
        )
      }
      {d.quickHits && <QuickHits items={d.quickHits} />}
      {d.tool && <ToolCard tool={d.tool} />}
      {d.wildcard && <Wildcard wildcard={d.wildcard} />}
      {d.yourTurn && <YourTurn game={d.yourTurn} />}
      {d.comingNext && <p class="border-t border-line pt-6" set:html={md(d.comingNext)} />}
      {
        d.sources.length > 0 && (
          <footer class="sources" aria-labelledby="sources-title">
            <h2 id="sources-title" class="eyebrow eyebrow--line">Sources</h2>
            <ol class="mt-4 grid gap-1.5">
              {d.sources.map((s) => (
                <li>
                  <a href={s.url} target="_blank" rel="noopener">
                    {s.label}
                  </a>
                </li>
              ))}
            </ol>
          </footer>
        )
      }
      <div class="no-print">
        <PrevNext prev={older} next={newer} />
      </div>
      <!-- Only in the PDF: sign-off with a link back to the issue online -->
      <div class="print-end">
        <p class="display">Thanks for reading.</p>
        <p>Read this issue online at <a href={url}>{url.replace(/^https?:\/\//, '')}</a></p>
      </div>
    </div>
  </article>

  <ActionBar slot="bottom" url={url} title={shareTitle} pdfName={`AI Journey Issue ${d.issue}`} />
</BaseLayout>

<style>
  .issue-head {
    margin-block-start: clamp(2rem, 4vw, 3.5rem);
  }
  .issue-title {
    max-inline-size: 20ch;
    margin-block-start: 1.25rem;
    font-size: clamp(2.5rem, 1.65rem + 3vw, 4.25rem);
    font-weight: 750;
    line-height: 1.12;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .issue-deck {
    max-inline-size: 36rem;
    margin-block-start: 1.5rem;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.55;
  }
  .issue-byline {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 2rem;
    margin-block-start: 1.75rem;
    padding-block: 1.125rem;
    border-block-start: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.6;
  }
  .issue-author span {
    color: var(--heading);
    font-weight: 500;
  }
  .issue-dateline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
  }
  .issue-dateline > span:last-child {
    white-space: nowrap;
  }
  .intro {
    color: var(--heading);
  }
  .intro,
  .stories {
    font-size: 1.125rem;
    line-height: 1.85;
  }
  .stories :global(p),
  .stories :global(li) {
    text-wrap: pretty;
  }
  .stories :global(h3) {
    font-family: var(--font-display);
    font-size: 1.25em;
    font-weight: 700;
    line-height: 1.35;
    margin-block-start: 1.75em;
  }
  @media screen and (min-width: 48rem) {
    .intro,
    .stories {
      font-size: 1.125rem;
    }
  }
  .issue-sections :global(section[id]),
  .stories :global(h2[id]) {
    scroll-margin-top: calc(var(--chips-h) + 1rem);
  }

  /* Brief format: each "## Brief" heading starts a new section */
  .stories :global(h2) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin-block-start: 3rem;
    padding-block-start: 2rem;
    border-block-start: 1px solid var(--border);
  }
  .stories :global(h2:first-child) {
    margin-block-start: 0;
    padding-block-start: 0;
    border-block-start: 0;
  }
  .stories :global(h2 + p:has(img)) {
    margin-block-start: 1.5rem;
  }
  .stories :global(p:has(> img)) {
    margin-block: 1.75rem;
  }
  .stories :global(img) {
    display: block;
    inline-size: 100%;
    height: auto;
    border-radius: 0.625rem;
    border: 1px solid var(--border);
    background: var(--surface-2);
  }

  /* A picture that links somewhere (for example to the original article) */
  .stories :global(a:has(> img)) {
    display: block;
    border-radius: 0.625rem;
    transition: opacity 150ms ease;
  }
  .stories :global(a:has(> img):hover) {
    opacity: 0.88;
  }

  .sources {
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--border);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .sources a {
    color: var(--muted);
  }
  .sources a:hover {
    color: var(--heading);
  }

  /* ------------------------------------------------------------------
     PDF (print) layout: a newsletter page with a nameplate, story labels
     and smaller pictures. The screen layout is above.
     ------------------------------------------------------------------ */
  .print-mast,
  .print-end {
    display: none;
  }

  @media print {
    /* Nameplate: logo and name, tagline, then issue, date and read time between rules */
    .print-mast {
      display: block;
      margin-block-end: 7mm;
      text-align: center;
    }
    .pm-name {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 3mm;
    }
    .pm-name img {
      inline-size: 15mm;
      height: auto;
    }
    .pm-name .display {
      font-size: 38pt;
      line-height: 1;
    }
    .pm-tag {
      margin-block-start: 1.5mm;
      font-size: 7.5pt;
      font-weight: 600;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .pm-dateline {
      display: flex;
      justify-content: space-between;
      margin-block-start: 5mm;
      padding-block: 1.8mm;
      border-block-start: 2.5pt solid var(--heading);
      border-block-end: 0.75pt solid var(--heading);
      font-size: 7.5pt;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--heading);
    }

    .wrap-mast {
      padding-block-start: 0;
    }
    .issue-head {
      margin-block-start: 0;
      text-align: center;
    }
    .issue-head h1 {
      margin-block-start: 0;
      font-size: 34pt;
    }
    .issue-head .lead {
      margin-block-start: 2.5mm;
      margin-inline: auto;
      font-family: var(--font-display);
      font-style: normal;
      font-weight: 500;
      font-size: 15pt;
    }

    /* Plain blocks instead of a grid, so every browser can split them across pages */
    .issue-sections {
      display: block;
      margin-block-start: 7mm;
      padding-block-end: 0;
    }
    .issue-sections > :global(*:not(:first-child)) {
      margin-block-start: 8mm;
    }

    /* Drop cap on the first paragraph */
    .intro {
      font-size: 11.5pt;
    }
    .intro > :global(p:first-child::first-letter) {
      float: left;
      padding: 0.05em 0.08em 0 0;
      font-family: var(--font-display);
      font-size: 3.6em;
      font-weight: 400;
      line-height: 0.8;
      color: var(--heading);
    }

    /* Stories */
    .stories {
      font-size: 11.5pt;
      line-height: 1.55;
    }
    .stories :global(h2),
    .stories :global(h2:first-child) {
      margin-block: 9mm 4mm;
      padding-block-start: 3mm;
      border-block-start: 2pt solid var(--heading);
      font-size: 22pt;
      break-inside: avoid;
      break-after: avoid;
    }
    .stories :global(h2:first-child) {
      margin-block-start: 0;
    }
    .stories :global(.story-num) {
      display: block;
      margin-block-end: 1.5mm;
      font-family: var(--font-sans);
      font-size: 7.5pt;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--accent);
    }
    .stories :global(.story-sep) {
      display: none;
    }
    .stories :global(h3) {
      margin-block-start: 4mm;
      font-size: 13pt;
      break-after: avoid;
    }

    /* Pictures: centered, at most about a third of the page tall */
    .stories :global(p:has(img)) {
      margin-block: 2mm 5mm;
      break-inside: avoid;
    }
    .stories :global(img) {
      inline-size: auto;
      max-inline-size: 100%;
      max-block-size: 85mm;
      margin-inline: auto;
      border-radius: 2mm;
    }
    .stories :global(h2 + p:has(img)) {
      margin-block-start: 0;
    }
    /* The bold opening line under the picture is a little larger */
    .stories :global(h2 + p:has(img) + p) {
      font-size: 12pt;
    }

    .sources {
      padding-block-start: 4mm;
      border-block-start: 2pt solid var(--heading);
      font-size: 8pt;
    }

    .print-end {
      display: block;
      padding-block-start: 4mm;
      border-block-start: 0.75pt solid var(--heading);
      text-align: center;
      font-size: 9pt;
      color: var(--muted);
      break-inside: avoid;
    }
    .print-end .display {
      font-size: 18pt;
      color: var(--heading);
    }
    .print-end a {
      color: var(--accent);
      text-decoration: none;
    }
  }
</style>

<script>
  // Links inside stories open in a new tab, so readers keep their place in the issue
  document.querySelectorAll<HTMLAnchorElement>('.stories a[href^="http"]').forEach((a) => {
    a.target = '_blank';
    a.rel = 'noopener';
  });

  // Wrap the "Brief 1" part of each brief title, so the PDF can show it as a small label.
  // On screen the title reads exactly as before.
  document.querySelectorAll<HTMLHeadingElement>('.stories h2').forEach((h) => {
    const text = h.firstChild;
    const match = text?.nodeType === Node.TEXT_NODE ? text.textContent?.match(/^([^:]+):\s/) : null;
    if (!text || !match) return;
    const num = document.createElement('span');
    const sep = document.createElement('span');
    num.className = 'story-num';
    sep.className = 'story-sep';
    sep.textContent = ': ';
    num.append(match[1], sep);
    text.textContent = text.textContent!.slice(match[0].length);
    h.prepend(num);
  });
</script>
