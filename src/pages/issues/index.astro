---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Icon from '../../components/Icon.astro';
import IssueCard from '../../components/IssueCard.astro';
import { getIssues, u } from '../../lib/utils';

const issues = await getIssues();
---

<BaseLayout title="Blogs" description="Ideas, reflections, and student perspectives from AI Journey at AUB.">
  <section class="wrap newsletter-intro" aria-labelledby="newsletter-title">
    <Breadcrumb items={[{ label: 'Home', href: u('/') }, { label: 'Blogs' }]} />
    <div class="newsletter-heading">
      <div>
        <p class="eyebrow">From AI Journey at AUB</p>
        <h1 id="newsletter-title" class="display">Blogs.</h1>
        <p class="newsletter-description">Ideas, reflections, and perspectives from our student community. Explore what we’ve been writing.</p>
      </div>
      <a href={u('/#join')} class="btn btn-primary">Get new posts <Icon name="arrow-right" size={18} /></a>
    </div>
  </section>

  <section class="wrap issue-archive" aria-labelledby="issues-title">
    <div class="archive-toolbar">
      <div class="archive-label"><h2 id="issues-title">Published posts</h2><span>{issues.length} {issues.length === 1 ? 'post' : 'posts'}</span></div>
      {issues.length > 1 && (
        <div class="archive-sort" role="group" aria-label="Sort posts">
          <button type="button" class="chip" data-sort="newest" aria-pressed="true">Newest first</button>
          <button type="button" class="chip" data-sort="oldest" aria-pressed="false">Oldest first</button>
        </div>
      )}
    </div>
    {issues.length > 0 ? (
      <ul class="issue-list" data-issues>
        {issues.map((issue, index) => <li data-issue={issue.data.issue}><IssueCard issue={issue} headingLevel="h3" featured={index === 0} /></li>)}
      </ul>
    ) : (
      <div class="issue-empty">
        <h3 class="display">Our first post is on the way.</h3>
        <p>Subscribe and we’ll send it to your inbox when it’s published.</p>
        <a href={u('/#join')} class="editorial-link">Get new posts <Icon name="arrow-right" size={18} /></a>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .newsletter-intro, .issue-archive { max-inline-size: 68rem; }
  .newsletter-intro { padding-block-start: 1.5rem; }
  .newsletter-heading { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1.75rem 2.5rem; padding-block: clamp(2rem, 3.2vw, 3rem) 2rem; border-block-end: 1px solid var(--border-strong); }
  .newsletter-heading > div { flex: 1 1 28rem; }
  .newsletter-heading > .btn { flex: none; margin-block-end: 0.25rem; }
  .newsletter-heading h1 { margin-block-start: 1rem; font-size: clamp(3.25rem, 2rem + 3vw, 4.5rem); font-weight: 750; line-height: 1.05; letter-spacing: -0.06em; }
  .newsletter-description { max-inline-size: 35rem; margin-block-start: 1.125rem; color: var(--muted); font-size: clamp(1rem, 0.95rem + 0.3vw, 1.125rem); line-height: 1.75; }
  .issue-archive { padding-block: 1.5rem 5rem; }
  .archive-toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-block-end: 1.125rem; }
  .archive-label { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  .archive-label h2 { font-family: var(--font-display); color: var(--heading); font-size: 0.9375rem; font-weight: 650; line-height: 1.4; letter-spacing: -0.02em; }
  .archive-label span { display: inline-flex; align-items: center; min-block-size: 1.75rem; padding-inline: 0.625rem; border: 1px solid var(--border); border-radius: 999px; color: var(--muted); font-size: 0.75rem; font-variant-numeric: tabular-nums; }
  .archive-sort { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .issue-list { border-block-start: 0; }
  .issue-list > li { border-block-end: 0; }
  .issue-list > li + li { margin-block-start: 1.5rem; }
  .issue-empty { display: grid; justify-items: start; gap: 0.875rem; padding: 2rem; border: 1px solid var(--border); border-radius: 0.75rem; background: var(--bg-alt); }
  .issue-empty h3 { font-size: 1.5rem; font-weight: 700; }
  .issue-empty p { max-inline-size: 30rem; color: var(--muted); font-size: 0.9375rem; line-height: 1.7; }
  @media (max-width: 47.99rem) { .newsletter-intro { padding-block-start: 1rem; } .newsletter-heading { gap: 1rem; padding-block: 1.5rem; } .newsletter-heading h1 { margin-block-start: 0.75rem; } .newsletter-description { margin-block-start: 0.875rem; line-height: 1.65; } .issue-archive { padding-block-start: 1.25rem; } .archive-toolbar { margin-block-end: 1rem; } }
  @media (min-width: 48rem) { .issue-archive { padding-block: 1.75rem 6rem; } }
</style>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-sort]')];
  const list = document.querySelector<HTMLElement>('[data-issues]');
  buttons.forEach((button) => button.addEventListener('click', () => {
    if (!list) return;
    const order = button.dataset.sort;
    const items = [...list.querySelectorAll<HTMLElement>(':scope > li')];
    items.sort((a, b) => {
      const difference = Number(a.dataset.issue) - Number(b.dataset.issue);
      return order === 'oldest' ? difference : -difference;
    });
    list.append(...items);
    buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
  }));
</script>
