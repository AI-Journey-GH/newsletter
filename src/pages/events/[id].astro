---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ActivityCard from '../../components/ActivityCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CommunityPhoto from '../../components/CommunityPhoto.astro';
import Icon from '../../components/Icon.astro';
import NextUp from '../../components/NextUp.astro';
import { activities, materialIcon, type Activity } from '../../data/activities';
import { galleryPhotos } from '../../data/gallery';
import { u } from '../../lib/utils';

export function getStaticPaths() {
  return activities.map((activity) => ({ params: { id: activity.id }, props: { activity } }));
}

interface Props { activity: Activity; }
const { activity } = Astro.props;
const isRecap = activity.sourceKind === 'recap';
const photos = activity.galleryEvent ? galleryPhotos.filter((photo) => photo.event === activity.galleryEvent) : [];
const others = activities.filter((item) => item.id !== activity.id).slice(0, 3);
const og = await getImage({ src: activity.cover.src, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
const split = Boolean(activity.speakers?.length || activity.materials?.length);
const frameStyle = (photo: (typeof photos)[number]) => {
  const f = photo.frame;
  if (!f) return undefined;
  return `--ratio: ${f.width / f.height}; --w: ${photo.src.width / f.width * 100}%; --x: ${-f.x / f.width * 100}%; --y: ${-f.y / f.height * 100}%;`;
};
const topicsLabel = activity.category === 'Bootcamps' ? 'The sessions' : 'What we covered';
---

<BaseLayout title={activity.title} description={activity.summary} image={og.src}>
  <div class="wrap activity-page">
    <Breadcrumb items={[{ label: 'Home', href: u('/') }, { label: 'Activities', href: u('/events') }, { label: activity.title }]} />

    <header class="activity-head">
      <div class="head-copy">
        <p class="eyebrow">{activity.category} / {isRecap ? 'Event recap' : 'Announcement'}</p>
        <h1 class="display activity-title">{activity.title}</h1>
        <p class="activity-summary">{activity.summary}</p>
        <ul class="activity-facts">
          <li><Icon name="calendar" size={17} />{activity.date ? <time datetime={activity.date}>{activity.periodLabel}</time> : activity.periodLabel}</li>
          <li><Icon name="pin" size={17} />AUB, Beirut</li>
        </ul>
        <div class="head-actions">
          <a href={activity.sourceUrl} class="btn btn-primary" target="_blank" rel="noopener"><Icon name="instagram" size={19} />{isRecap ? 'See the recap' : 'See the original post'}</a>
        </div>
      </div>
      <figure class:list={['head-media', !isRecap && 'head-media--poster']} style={`view-transition-name: activity-${activity.id}`}>
        {isRecap ? (
          <CommunityPhoto priority />
        ) : (
          <Image src={activity.cover.src} alt={activity.cover.alt} widths={[480, 720, 960]} sizes="(min-width: 1024px) 40vw, 100vw" format="webp" quality={85} loading="eager" fetchpriority="high" class="head-poster" />
        )}
      </figure>
    </header>

    <div class:list={['activity-details', split && 'activity-details--split']}>
      <section class="detail-block" aria-labelledby="topics-title">
        <h2 id="topics-title" class="detail-title">{topicsLabel}</h2>
        <ol class="topic-list">
          {activity.topics.map((topic, index) => (
            <li><span class="topic-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>{topic}</li>
          ))}
        </ol>
      </section>

      {activity.materials && activity.materials.length > 0 && (
        <section class="detail-block" aria-labelledby="materials-title">
          <h2 id="materials-title" class="detail-title">Materials</h2>
          <ul class="material-list">
            {activity.materials.map((item) => (
              <li><a href={item.href} target="_blank" rel="noopener"><Icon name={materialIcon[item.kind]} size={20} /><span><span class="material-kind">{item.kind}</span>{item.label}</span><Icon name="external" size={15} /></a></li>
            ))}
          </ul>
        </section>
      )}

      {activity.speakers && activity.speakers.length > 0 && (
        <section class="detail-block" aria-labelledby="speakers-title">
          <h2 id="speakers-title" class="detail-title">Speakers</h2>
          <ul class="speaker-list">
            {activity.speakers.map((speaker) => (
              <li>
                <span class="speaker-initials" aria-hidden="true">{speaker.name.split(' ').map((part) => part[0]).slice(0, 2).join('')}</span>
                <div><p class="speaker-name">{speaker.name}</p><p class="speaker-role">{speaker.role}</p></div>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    {photos.length > 0 && (
      <section class="activity-photos" aria-labelledby="photos-title">
        <h2 id="photos-title" class="detail-title">Photos</h2>
        <ul class="photo-grid">
          {photos.map((photo) => (
            <li>
              <figure>
                <a href={photo.sourceUrl} target="_blank" rel="noopener" class:list={['photo-link', photo.frame && 'photo-link--framed']} style={frameStyle(photo)} aria-label={`Open on Instagram: ${photo.alt}`}>
                  <Image src={photo.src} alt={photo.alt} widths={[480, 800, 1200]} sizes="(min-width: 768px) 50vw, 100vw" format="webp" quality={85} loading="lazy" class="photo" />
                </a>
                <figcaption>{photo.caption}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </section>
    )}

    <NextUp id="activity-next" />

    <section class="more-activities" aria-labelledby="more-title">
      <div class="more-heading">
        <h2 id="more-title" class="display more-title">More from AI Journey</h2>
        <a href={u('/events')} class="editorial-link">All activities <Icon name="arrow-right" size={18} /></a>
      </div>
      <ul class="more-grid">{others.map((item) => <li><ActivityCard activity={item} /></li>)}</ul>
    </section>
  </div>
</BaseLayout>

<style>
  .activity-page { padding-block: 1.5rem 4rem; }
  .activity-head { display: grid; align-items: center; gap: 2rem; padding-block: 2rem 2.5rem; }
  .head-copy { min-inline-size: 0; }
  .activity-title { margin-block-start: 0.875rem; font-size: clamp(2.25rem, 1.35rem + 3.5vw, 3.75rem); font-weight: 730; line-height: 1.1; letter-spacing: -0.045em; text-wrap: balance; }
  .activity-summary { max-inline-size: 38rem; margin-block-start: 1.25rem; color: var(--muted); font-size: 1.0625rem; line-height: 1.75; }
  .activity-facts { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-block-start: 1.25rem; color: var(--text); font-size: 0.875rem; }
  .activity-facts li { display: inline-flex; align-items: center; gap: 0.5rem; }
  .activity-facts :global(svg) { color: var(--accent); }
  .head-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-block-start: 1.75rem; }
  .head-actions .btn { min-block-size: 3rem; gap: 0.5rem; }
  .head-media { min-inline-size: 0; overflow: hidden; border-radius: 1rem; }
  .head-media :global(.community-photo) { aspect-ratio: 1.6; }
  .head-media :global(.community-photo-image) { inline-size: 150%; inset-inline-start: -25%; }
  .head-media--poster { display: flex; justify-content: center; padding: clamp(1rem, 3vw, 2rem); background: #182b49; }
  .head-poster { display: block; inline-size: 100%; max-inline-size: 28rem; block-size: auto; border-radius: 0.375rem; }
  .activity-details { display: grid; gap: 2rem; padding-block: 2rem; border-block-start: 1px solid var(--border); }
  .detail-title { color: var(--heading); font-family: var(--font-display); font-size: 1.25rem; font-weight: 700; letter-spacing: -0.025em; }
  .topic-list { display: grid; gap: 0.625rem; margin-block-start: 1rem; }
  .topic-list li { display: flex; align-items: center; gap: 0.875rem; min-block-size: 3.25rem; padding: 0.625rem 1rem; border: 1px solid var(--border); border-radius: 0.75rem; background: var(--surface); color: var(--heading); font-size: 0.9375rem; font-weight: 550; }
  .topic-index { flex: none; color: var(--accent); font-family: var(--font-display); font-size: 0.8125rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .material-list { display: grid; gap: 0.625rem; margin-block-start: 1rem; }
  .material-list a { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 0.875rem; padding: 0.75rem 1rem; border: 1px solid var(--border); border-radius: 0.75rem; background: var(--surface); color: var(--heading); font-size: 0.9375rem; font-weight: 550; text-decoration: none; }
  .material-list a:hover { border-color: var(--border-strong); background: var(--surface-2); }
  .material-list a > :global(svg:first-child) { color: var(--accent); }
  .material-kind { display: block; color: var(--muted); font-size: 0.75rem; font-weight: 500; }
  .speaker-list { display: grid; gap: 0.75rem; margin-block-start: 1rem; }
  .speaker-list li { display: flex; align-items: center; gap: 0.875rem; padding: 0.875rem 1rem; border-radius: 0.75rem; background: var(--bg-alt); }
  .speaker-initials { display: inline-flex; align-items: center; justify-content: center; flex: none; inline-size: 2.75rem; block-size: 2.75rem; border-radius: 999px; background: var(--btn-bg); color: var(--btn-fg); font-size: 0.875rem; font-weight: 700; letter-spacing: 0.02em; }
  .speaker-name { color: var(--heading); font-size: 0.9375rem; font-weight: 650; }
  .speaker-role { margin-block-start: 0.125rem; color: var(--muted); font-size: 0.8125rem; }
  .activity-photos { padding-block: 2rem; border-block-start: 1px solid var(--border); }
  .photo-grid { display: grid; gap: 1rem; margin-block-start: 1rem; }
  .photo-grid:not(:has(> li:nth-child(2))) { max-inline-size: 46rem; }
  .photo-link { display: block; overflow: hidden; border-radius: 0.875rem; background: var(--surface-2); }
  .photo { display: block; inline-size: 100%; block-size: auto; transition: transform 300ms ease; }
  .photo-link--framed { position: relative; aspect-ratio: var(--ratio); }
  .photo-link--framed .photo { position: absolute; inset-inline-start: var(--x); inset-block-start: var(--y); inline-size: var(--w); max-inline-size: none; }
  .photo-link:hover .photo { transform: scale(1.02); }
  .activity-photos figcaption { margin-block-start: 0.625rem; color: var(--muted); font-size: 0.8125rem; }
  .activity-page :global(.next-up) { padding-block: 2rem; border-block-start: 1px solid var(--border); }
  .more-activities { padding-block-start: 2.5rem; border-block-start: 1px solid var(--border); }
  .more-heading { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem; margin-block-end: 1.5rem; }
  .more-title { font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2rem); font-weight: 700; letter-spacing: -0.035em; }
  .more-heading .editorial-link { font-size: 0.875rem; }
  .more-grid { display: grid; gap: 1.5rem; }
  .more-grid > li { display: flex; min-inline-size: 0; }
  @media (min-width: 40rem) {
    .more-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .speaker-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 56rem) {
    .activity-details--split { grid-template-columns: 1fr 1fr; gap: 3rem; }
    .activity-details--split .speaker-list { grid-template-columns: minmax(0, 1fr); }
    .activity-details:not(.activity-details--split) .topic-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .photo-grid:has(> li:nth-child(2)) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .more-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 64rem) {
    .activity-page { padding-block: 2rem 5rem; }
    .activity-head { grid-template-columns: 1.05fr 1fr; gap: 3.5rem; padding-block: 3rem 3.5rem; }
  }
</style>
