---
import BaseLayout from '../layouts/BaseLayout.astro';
import ActivityCard from '../components/ActivityCard.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CommunityPhoto from '../components/CommunityPhoto.astro';
import Icon from '../components/Icon.astro';
import { links } from '../config';
import { activities, activityCategories } from '../data/activities';
import { u } from '../lib/utils';

const featured = activities.find((activity) => activity.featured);
const categoryCount = (category: string) => category === 'All' ? activities.length : activities.filter((activity) => activity.category === category).length;
---

<BaseLayout title="Our activities" description="Explore the talks, bootcamps, and learning series hosted by AI Journey at AUB. A look back at our community, with original event posts and recaps.">
  <div class="wrap activities-page">
    <Breadcrumb items={[{ label: 'Home', href: u('/') }, { label: 'Activities' }]} />
    <section class="activities-intro" aria-labelledby="activities-title">
      <div>
        <p class="eyebrow">Learn. Build. Connect.</p>
        <h1 id="activities-title" class="display page-title">Ideas brought to life.</h1>
        <p class="intro-description">Talks, bootcamps, and learning series from AI Journey at AUB. Explore the moments, people, and ideas we’ve shared.</p>
      </div>
      <a href={links.whatsapp} class="btn btn-primary" target="_blank" rel="noopener">Get new announcements <Icon name="arrow-right" size={18} /></a>
    </section>

    {
      featured && (
        <section class="featured-section" aria-labelledby="featured-title">
          <div class="section-heading"><h2 class="display section-title" id="featured-title">A conversation to look back on</h2><span class="past-label">Past activity</span></div>
          <article class="featured-activity">
            <a href={featured.sourceUrl} class="featured-photo" target="_blank" rel="noopener" aria-label={`See the ${featured.title} event recap on Instagram`}><CommunityPhoto priority /></a>
            <div class="featured-copy">
              <p class="eyebrow">{featured.category} / Event recap</p>
              <h3 class="display featured-title">{featured.title}</h3>
              <p class="featured-description">{featured.summary}</p>
              <p class="featured-date"><Icon name="calendar" size={17} />{featured.date ? <time datetime={featured.date}>{featured.periodLabel}</time> : featured.periodLabel}<span aria-hidden="true">·</span>AUB</p>
              <div class="speakers"><div><p>Ali Saab</p><span>Researcher, OpenAI</span></div><div><p>Mohamad El Hajj</p><span>Security Researcher, Anthropic</span></div></div>
              <a href={featured.sourceUrl} class="editorial-link" target="_blank" rel="noopener">See the event recap <Icon name="arrow-right" size={18} /></a>
            </div>
          </article>
        </section>
      )
    }

    <section class="archive-section" aria-labelledby="archive-title">
      <div class="section-heading archive-heading">
        <div><p class="eyebrow">The activity archive</p><h2 class="display section-title" id="archive-title">A shared journey, so far.</h2></div>
        <p class="activity-count" role="status" aria-live="polite" aria-atomic="true" data-activity-count>{activities.length} past activities</p>
      </div>
      <div class="activity-filters" role="group" aria-label="Filter activities by type">
        {activityCategories.map((category) => <button type="button" class="activity-filter" aria-pressed={category === 'All' ? 'true' : 'false'} aria-controls="activities-grid" data-activity-filter={category}>{category}<span class="filter-count" aria-hidden="true">{categoryCount(category)}</span></button>)}
      </div>
      <ul id="activities-grid" class="activity-grid" data-activity-grid>
        {activities.map((activity) => <li data-activity-category={activity.category}><ActivityCard activity={activity} /></li>)}
      </ul>
      <p class="archive-note">These are past activities. Visit the original posts for each activity’s announcement or recap.</p>
    </section>

    <section class="announcement-band" aria-labelledby="announcements-title">
      <div><p class="eyebrow">Stay connected</p><h2 class="display" id="announcements-title">Be part of what comes next.</h2><p>New activity announcements and registration details are shared through our community channels.</p></div>
      <div class="announcement-actions"><a href={links.whatsapp} class="btn btn-primary" target="_blank" rel="noopener"><Icon name="whatsapp" size={19} /> Join on WhatsApp</a><a href={links.instagram} class="editorial-link" target="_blank" rel="noopener">Follow on Instagram <Icon name="arrow-right" size={18} /></a></div>
    </section>
  </div>
</BaseLayout>

<style>
  .activities-page { padding-block: 1.5rem 4rem; }
  .activities-intro { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1.5rem 3rem; padding-block: 2.5rem 3rem; }
  .page-title { margin-block-start: 0.875rem; max-inline-size: 19ch; font-size: clamp(2.25rem, 1.35rem + 3.5vw, 4rem); font-weight: 730; line-height: 1.1; letter-spacing: -0.045em; }
  .intro-description { max-inline-size: 40rem; margin-block-start: 1.25rem; color: var(--muted); font-size: 1.0625rem; line-height: 1.75; }
  .activities-intro > .btn { min-block-size: 3rem; flex: none; margin-block-end: 0.25rem; }
  .section-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; margin-block-end: 1.5rem; }
  .section-title { font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2rem); font-weight: 700; line-height: 1.3; letter-spacing: -0.035em; }
  .past-label { border: 1px solid var(--border-strong); padding: 0.375rem 0.75rem; border-radius: 999px; color: var(--muted); font-size: 0.75rem; font-weight: 600; }
  .featured-activity { display: grid; gap: 1.5rem; padding: 1rem; border: 1px solid var(--border); border-radius: 0.875rem; background: var(--surface); }
  .featured-photo { display: block; min-inline-size: 0; align-self: center; }
  .featured-photo :global(.community-photo) { border-radius: 0.625rem; }
  .featured-copy { min-inline-size: 0; padding: 0.25rem; }
  .featured-title { margin-block-start: 0.875rem; font-size: clamp(1.75rem, 1.25rem + 1.9vw, 2.625rem); font-weight: 730; line-height: 1.15; letter-spacing: -0.035em; }
  .featured-description { max-inline-size: 38rem; margin-block-start: 1rem; color: var(--muted); font-size: 0.9375rem; line-height: 1.75; }
  .featured-date { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-block-start: 1.25rem; color: var(--muted); font-size: 0.8125rem; }
  .speakers { display: grid; gap: 0.875rem; margin-block: 1.25rem 0.75rem; padding-block-start: 1.25rem; border-block-start: 1px solid var(--border); }
  .speakers p { color: var(--heading); font-size: 0.875rem; font-weight: 650; }
  .speakers span { display: block; margin-block-start: 0.25rem; color: var(--muted); font-size: 0.75rem; line-height: 1.6; }
  .archive-section { margin-block-start: 3rem; }
  .archive-heading { align-items: end; }
  .archive-heading .section-title { margin-block-start: 0.75rem; }
  .activity-count { color: var(--muted); font-size: 0.8125rem; }
  .activity-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-block-end: 1.5rem; }
  .activity-filter { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; min-block-size: 2.75rem; padding: 0.625rem 0.875rem; border: 1px solid var(--border-strong); border-radius: 0.5rem; background: var(--bg); color: var(--heading); font-size: 0.8125rem; font-weight: 550; line-height: 1.4; cursor: pointer; transition: color 150ms ease, border-color 150ms ease, background-color 150ms ease; }
  .activity-filter:hover { border-color: var(--heading); }
  .activity-filter[aria-pressed='true'] { border-color: var(--btn-bg); background: var(--btn-bg); color: var(--btn-fg); }
  .filter-count { font-size: 0.6875rem; font-weight: 600; opacity: 0.75; }
  .activity-grid { display: grid; grid-template-columns: minmax(0, 1fr); align-items: stretch; gap: 1.5rem; }
  .activity-grid > li { display: flex; min-inline-size: 0; }
  .activity-grid > li[hidden] { display: none; }
  .archive-note { margin-block-start: 1.75rem; color: var(--muted); font-size: 0.8125rem; line-height: 1.7; }
  .announcement-band { display: grid; align-items: center; gap: 1.5rem 3rem; margin-block-start: 3rem; padding: 1.75rem; border-radius: 0.875rem; background: var(--bg-alt); }
  .announcement-band h2 { margin-block-start: 0.875rem; font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem); font-weight: 700; line-height: 1.3; letter-spacing: -0.035em; }
  .announcement-band p:last-child { max-inline-size: 35rem; margin-block-start: 0.75rem; color: var(--muted); font-size: 0.9375rem; line-height: 1.75; }
  .announcement-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; }
  @media (min-width: 40rem) { .speakers { grid-template-columns: 1fr 1fr; } .activity-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .activities-page { padding-block: 2rem 5rem; } .activities-intro { padding-block: 3rem 3.5rem; } .featured-activity { grid-template-columns: 1.1fr 1fr; padding: 1.5rem; gap: 2rem; } .featured-copy { padding: 0.5rem 0.25rem; } .archive-section { margin-block-start: 4rem; } .announcement-band { grid-template-columns: 1.15fr 1fr; padding: 2.25rem; } .announcement-actions { justify-content: end; } }
</style>

<script>
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-activity-filter]')];
  const items = [...document.querySelectorAll<HTMLElement>('[data-activity-category]')];
  const count = document.querySelector<HTMLElement>('[data-activity-count]');
  filters.forEach((button) => {
    button.addEventListener('click', () => {
      const category = button.dataset.activityFilter ?? 'All';
      let visible = 0;
      items.forEach((item) => {
        const matches = category === 'All' || item.dataset.activityCategory === category;
        item.hidden = !matches;
        if (matches) visible += 1;
      });
      filters.forEach((filter) => filter.setAttribute('aria-pressed', String(filter === button)));
      if (count) count.textContent = `${visible} past ${visible === 1 ? 'activity' : 'activities'}`;
    });
  });
</script>
